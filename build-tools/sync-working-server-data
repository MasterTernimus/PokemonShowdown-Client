#!/usr/bin/env node
'use strict';
// Reconcile only data entries touched since the supplied server base revision.
// No fetch, pull, reset, commit, or mutation of the server checkout occurs here.
const fs = require('fs');
const path = require('path');
const cp = require('child_process');
const crypto = require('crypto');
const ts = require('typescript');
const root = path.resolve(__dirname, '..');
if (!process.env.PS_SERVER_SOURCE) throw new Error('Set PS_SERVER_SOURCE to the approved, freshly built server checkout.');
const server = fs.realpathSync(process.env.PS_SERVER_SOURCE);
const manifestPath = path.join(root, 'server-data-sync-manifest.json');
const previous = fs.existsSync(manifestPath) ? JSON.parse(fs.readFileSync(manifestPath, 'utf8')) : {};
const base = process.env.PS_SERVER_BASE || previous.base || 'HEAD';
const git = args => cp.execFileSync('git', args, {cwd: server, encoding: 'utf8', maxBuffer: 32 * 1024 * 1024});
const {Dex} = require(path.join(server, 'dist/sim/dex'));
Dex.includeData();
const groups = {species: new Set(), abilities: new Set(), moves: new Set(), items: new Set()};
const tables = {species: Dex.data.Pokedex, abilities: Dex.data.Abilities, moves: Dex.data.Moves, items: Dex.data.Items};
// Refresh prior overrides too: a newer Git base must not erase already-synced work.
for (const key of Object.keys(groups)) {
	for (const id of Object.keys(previous.snapshot?.[key] || {})) {
		if (Object.prototype.hasOwnProperty.call(tables[key], id)) groups[key].add(id);
	}
}
const changed = [...new Set((git(['diff', '--name-only', base, '--', 'data']) + '\n' +
	git(['ls-files', '--others', '--exclude-standard', '--', 'data'])).trim().split('\n').filter(Boolean))];
for (const file of changed) {
	if (!file.endsWith('.ts') || !fs.existsSync(path.join(server, file))) continue;
	const text = fs.readFileSync(path.join(server, file), 'utf8');
	const diff = git(['diff', '--unified=0', base, '--', file]);
	const ranges = Array.from(diff.matchAll(/^@@ .*? \+(\d+)(?:,(\d+))? @@/gm), m => [+m[1] - 1, +m[1] - 1 + Math.max(1, +(m[2] ?? 1))]);
	const source = ts.createSourceFile(file, text, ts.ScriptTarget.Latest, true);
	function visit(node) {
		if (ts.isPropertyAssignment(node) && (ts.isIdentifier(node.name) || ts.isStringLiteral(node.name))) {
			const id = node.name.text;
			const start = source.getLineAndCharacterOfPosition(node.getStart(source)).line;
			const end = source.getLineAndCharacterOfPosition(node.end).line;
			if (ranges.some(([a, b]) => start < b && end >= a)) {
				for (const key of Object.keys(tables)) if (Object.prototype.hasOwnProperty.call(tables[key], id)) groups[key].add(id);
			}
		}
		ts.forEachChild(node, visit);
	}
	visit(source);
}
if (!Object.values(groups).some(ids => ids.size)) throw new Error('No changed entries. Supply the approved PS_SERVER_BASE; refusing to erase the snapshot.');
// Computed display summaries can change without a property-level source diff.
// Include their effective Dex values so older client overrides cannot mask them.
const {getAbilityDisplayComponents} = require(path.join(server, 'dist/data/ability-display'));
for (const id of Object.keys(tables.abilities)) {
	if (Dex.abilities.get(id).num > 310 || getAbilityDisplayComponents(id).length) groups.abilities.add(id);
}
for (const species of Dex.species.all()) {
	// Explicit empty rows prevent combat variants inheriting the base species' passives in client fallbacks.
	if (species.passives.length || Dex.species.get(species.baseSpecies).passives.length) groups.species.add(species.id);
}
for (const id of Object.keys(Dex.data.Pokedex)) {
	const species = Dex.species.get(id);
	if (species.passives.length || Dex.species.get(species.baseSpecies).passives.length) groups.species.add(id);
}
const select = (entry, keys) => Object.fromEntries(keys.map(key => [key, entry[key]]).filter(([, value]) => value !== undefined));
const snapshot = {species: {}, abilities: {}, moves: {}, items: {}, components: {}};
const {AbilityComponents} = require(path.join(server, 'dist/data/ability-components'));
for (const id of [...groups.species].sort()) {
	const data = Dex.species.get(id);
	snapshot.species[id] = {...select(data, ['abilities', 'baseStats', 'types', 'passives']), replaceAbilities: true};
}
for (const id of [...groups.abilities].sort()) {
	const data = Dex.abilities.get(id);
	snapshot.abilities[id] = select(data, ['name', 'num', 'gen', 'desc', 'shortDesc', 'rating', 'flags', 'isNonstandard']);
	snapshot.components[id] = AbilityComponents[id] || [];
}
for (const id of [...groups.moves].sort()) {
	const data = Dex.moves.get(id);
	snapshot.moves[id] = select(data, ['name', 'num', 'type', 'category', 'basePower', 'accuracy', 'pp', 'priority', 'target', 'flags', 'desc', 'shortDesc']);
}
for (const id of [...groups.items].sort()) {
	const data = Dex.items.get(id);
	snapshot.items[id] = select(data, ['name', 'num', 'desc', 'shortDesc', 'gen', 'isNonstandard', 'megaStone', 'megaEvolves', 'itemUser', 'zMove', 'zMoveType', 'zMoveFrom', 'fling', 'naturalGift']);
}
snapshot.displayComponents = Object.fromEntries(Dex.abilities.all().map(ability => [ability.id, getAbilityDisplayComponents(ability.id)]));
const target = path.join(root, 'play.pokemonshowdown.com/src/battle-dex.ts');
let source = fs.readFileSync(target, 'utf8');
function block(kind, marker, code) {
	const begin = '// BEGIN SERVER WORKING SYNC ' + kind;
	const end = '// END SERVER WORKING SYNC ' + kind;
	const from = source.indexOf(begin);
	if (from >= 0) source = source.slice(0, from) + source.slice(source.indexOf(end, from) + end.length + 1);
	source = source.replace(marker, begin + '\n' + code + '\n' + end + '\n' + marker);
}
const json = data => JSON.stringify(data, null, '\t');
block('SPECIES', 'const CUSTOM_SPECIES_UPDATE_IDS =', `for (const [id, update] of Object.entries(${json(snapshot.species)})) {\n\tCUSTOM_SPECIES_UPDATES[id] = {...CUSTOM_SPECIES_UPDATES[id], ...update};\n\tif (CUSTOM_SPECIES[id]) Object.assign(CUSTOM_SPECIES[id].data, update);\n}`);
block('DISPLAY COMPONENTS', 'const CUSTOM_ABILITY_UPDATE_IDS =', `const CUSTOM_ABILITY_DISPLAY_COMPONENTS: {[id: string]: string[]} = ${json(snapshot.displayComponents)};`);
block('ABILITIES', 'const CUSTOM_ABILITY_UPDATE_IDS =', `Object.assign(CUSTOM_ABILITY_UPDATES, ${json(snapshot.abilities)});`);
block('MOVES', 'const CUSTOM_MOVE_UPDATE_IDS =', `Object.assign(CUSTOM_MOVE_UPDATES, ${json(snapshot.moves)});\nObject.assign(CUSTOM_ABILITY_COMPONENT_OVERRIDES, ${json(snapshot.components)});`);
block('ITEMS', 'const CUSTOM_ITEM_IDS =', `Object.assign(CUSTOM_ITEM_UPDATES, ${json(snapshot.items)});`);
fs.writeFileSync(target, source);
const hash = crypto.createHash('sha256');
for (const file of changed.sort()) { hash.update(file); hash.update(fs.readFileSync(path.join(server, file), 'utf8').replace(/\r\n/g, '\n')); }
const manifest = {sourceHead: git(['rev-parse', 'HEAD']).trim(), base, sourceDataSHA256: hash.digest('hex'), files: changed, snapshot};
fs.writeFileSync(path.join(root, 'server-data-sync-manifest.json'), JSON.stringify(manifest, null, '\t') + '\n');
console.log(JSON.stringify({species: groups.species.size, abilities: groups.abilities.size, moves: groups.moves.size, items: groups.items.size, sourceHead: manifest.sourceHead, sourceDataSHA256: manifest.sourceDataSHA256}));
